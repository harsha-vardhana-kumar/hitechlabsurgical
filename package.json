{
  "name": "hitechlabsurgical",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace @hitech/website",
    "start": "npm run start --workspace @hitech/website",
    "lint": "eslint apps packages tests --max-warnings=0",
    "typecheck": "npm run typecheck --workspace @hitech/website",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "tsx": "^4.0.0",
    "typescript": "6.0.3"
  }
}
